# ─────────────────────────────────────────────────────────────────────────────
# Portal de Comunicados TrustSis — variáveis de ambiente.
#
# ATENÇÃO: a configuração de integração (SSO/Entra ID, Graph, políticas e ITSM) agora é
# feita DENTRO DO PORTAL, em Administração › Integração — não mais aqui. O que você salva
# na tela fica no store e tem PRECEDÊNCIA sobre estas vars.
#
# As vars abaixo são apenas o BOOTSTRAP (valor inicial) e são todas OPCIONAIS: sem
# nenhuma delas o portal sobe em MODO DEMO, todo mundo entra como admin, e o primeiro
# acesso configura o Entra pela tela. É esse o caminho recomendado numa instalação nova.
# ─────────────────────────────────────────────────────────────────────────────

# BOOTSTRAP (opcional) — ID do aplicativo (Application/Client ID) do registro no Entra ID.
# Preferir configurar em Administração › Integração.
# @user
ENTRA_CLIENT_ID=

# BOOTSTRAP (opcional) — ID do diretório (Tenant ID) do Entra ID.
# @user
ENTRA_TENANT_ID=

# BOOTSTRAP (opcional) — Segredo do cliente, para o fluxo app-only (client credentials).
# @secret @user
ENTRA_CLIENT_SECRET=

# BOOTSTRAP (opcional) — Object ID (GUID) do grupo de ADMINS no Entra ID. Serve de
# super-admin de emergência: garante que exista alguém capaz de editar os perfis de acesso
# (inclusive o próprio), evitando que um admin se tranque fora.
# @user
ENTRA_ADMIN_GROUP_ID=

# IDENTIDADE DO PREVIEW (opcional) — UPN (email) do ÚNICO colaborador que o portal assume
# quando roda EMBUTIDO (preview do Hive), contexto em que o login do Entra é impossível.
# Não é escolhível pela interface: é o admin que sanciona esta identidade aqui (ou em
# Administração › Integração). Vazio = sem SSO o portal não exibe conteúdo (mostra o gate).
# @user
DEMO_USER_UPN=

# VÁLVULA DE ESCAPE da barreira de SSO. Deixe VAZIO no uso normal (quem manda é o
# interruptor em Administração › Integração). Ponha exatamente `false` para FORÇAR a
# barreira desligada, vencendo o que estiver salvo no portal: é a saída de emergência se a
# barreira for ligada com um SSO que não funciona e ninguém conseguir mais entrar.
# @user
AUTH_REQUIRED=

# ─────────────────────────────────────────────────────────────────────────────
# Integração com a plataforma de chamados trustsis-itsm (server-to-server, app-only).
# Só liga a integração quando ITSM_BASE_URL + ITSM_API_SCOPE estão preenchidos. Sem elas,
# os tickets ficam SÓ no store local do portal (funciona, mas não chega no ITSM).
# ─────────────────────────────────────────────────────────────────────────────

# URL base da API do ITSM (suppotcare), acessível a partir do servidor do portal.
# Ex.: https://192.168.1.115  (sem barra no final)
# @user
ITSM_BASE_URL=

# Escopo do token app-only para a API do ITSM (client-credentials). Normalmente
# api://<CLIENT_ID_do_app_ITSM>/.default — use o Application ID URI do registro do ITSM no Entra.
# @user
ITSM_API_SCOPE=

# Subdomínio do tenant no ITSM (multi-tenant). Padrão: trustsis. Só mude se for diferente.
# @user
ITSM_TENANT_SUBDOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# Políticas internas — pasta do SharePoint/OneDrive compartilhada com os colaboradores.
# As políticas NÃO são cadastradas no portal: ele apenas LISTA e abre os documentos dessa
# pasta (read-only) via Graph. Requer a permissão de APLICAÇÃO Sites.Read.All (ou
# Files.Read.All) concedida ao app no Entra + Grant admin consent. Vazio => página em modo demo.
# ─────────────────────────────────────────────────────────────────────────────

# Link de COMPARTILHAMENTO da pasta (botão "Copiar link" no SharePoint/OneDrive). Cada
# subpasta vira uma categoria; arquivos na raiz caem em "Geral".
# Ex.: https://trustsis.sharepoint.com/:f:/s/Politicas/EabC...
# @user
POLITICAS_SHARE_URL=
