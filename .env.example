# ─────────────────────────────────────────────────────────────────────────────
# Portal de Comunicados TrustSis — variáveis que o USUÁRIO preenche em Configurações.
# App registrado no Microsoft Entra ID. Sem estas vars, o portal roda em MODO DEMO
# (dados de exemplo), então o preview NUNCA quebra por falta de env.
# ─────────────────────────────────────────────────────────────────────────────

# ID do aplicativo (Application/Client ID) do registro no Entra ID
# @required @user
ENTRA_CLIENT_ID=

# ID do diretório (Tenant ID) do Entra ID
# @required @user
ENTRA_TENANT_ID=

# Segredo do cliente (Client Secret) — usado no fluxo app-only (client credentials) do Graph
# @required @secret @user
ENTRA_CLIENT_SECRET=

# Object ID (GUID) do grupo de ADMINS no Entra ID. Membros deste grupo podem
# criar/editar comunicados, eventos e aniversariantes. Os demais são usuários comuns.
# @user
ENTRA_ADMIN_GROUP_ID=

# UPN (email) do colaborador cujo perfil/agenda/organograma o portal exibe quando NÃO
# há login delegado (SSO). Ex.: usuario@trustsis.com.br. Deixe vazio p/ usar dados demo.
# @user
DEMO_USER_UPN=

# Client ID exposto ao FRONTEND para o SSO (MSAL.js) — normalmente o MESMO ENTRA_CLIENT_ID.
# Só necessário quando você registrar a Redirect URI (SPA) do preview no Entra.
# @user
VITE_ENTRA_CLIENT_ID=

# Tenant ID exposto ao FRONTEND (MSAL.js) — normalmente o MESMO ENTRA_TENANT_ID.
# @user
VITE_ENTRA_TENANT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Integração com a plataforma de chamados trustsis-itsm (server-to-server, app-only).
# Só liga a integração quando ITSM_BASE_URL + ITSM_API_SCOPE estão preenchidos. Sem elas,
# os tickets ficam SÓ no store local do portal (funciona, mas não chega no ITSM).
# ─────────────────────────────────────────────────────────────────────────────

# URL base da API do ITSM (suppotcare), acessível a partir do servidor do portal.
# Ex.: https://192.168.1.115  (sem barra no final)
# @user
ITSM_BASE_URL=

# Escopo do token app-only para a API do ITSM (client-credentials). Normalmente
# api://<CLIENT_ID_do_app_ITSM>/.default — use o Application ID URI do registro do ITSM no Entra.
# @user
ITSM_API_SCOPE=

# Subdomínio do tenant no ITSM (multi-tenant). Padrão: trustsis. Só mude se for diferente.
# @user
ITSM_TENANT_SUBDOMAIN=
